###############################################
# HOOPBRAIN PROXY — CORE SYSTEM .gitignore v2 #
# ULTRA MODE • CLEAN • SECURE • OPTIMIZED     #
###############################################

##########  SYSTEM LOGS & TEMP  ##########
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
pnpm-error.log
lerna-debug.log*

# Diagnostic reports
report.*.json

# Runtime files
pids/
*.pid
*.seed
*.pid.lock

# Lock files that cause build inconsistencies
package-lock.json
npm-shrinkwrap.json
yarn.lock
pnpm-lock.yaml


##########  NODE MODULES & DEPENDENCIES  ##########
node_modules/
jspm_packages/
web_modules/
bower_components/

# Optional package caches
.npm/
.yarn/
.pnp.*
.pnpm-store/


##########  ENVIRONMENT & SECRETS  ##########
.env        # Sensitive runtime config
.env.*      # All secret patterns
!.env.example   # Keep example template


##########  BUILD ARTIFACTS (Docker + Node)  ##########
dist/
build/
out/
tmp/
temp/
.cache/
.parcel-cache/

# Node compiled addons
build/Release/

# Binary package outputs
*.tgz


##########  TEST, COVERAGE, ANALYSIS  ##########
coverage/
*.lcov
.nyc_output/
lib-cov/
.grunt/


##########  EDITOR / IDE / OS TRASH  ##########
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp


##########  FLY.IO / DOCKER / DEPLOYMENT  ##########
# Fly.io internal state
.fly/
machine_state.json
fly-config.local.*

# Docker ignore zones
docker-data/
docker-cache/
docker-tmp/
.dockerignore

# BuildKit cache
/buildkit-cache/
.cache-docker/


##########  CI/CD & DEVOPS PIPELINES  ##########
.github/workflows/**/*.log
.github/actions/*/temp/
.gitlab/ci-cache/
.circleci/tmp/

# Local testing docker-compose files
docker-compose.override.yml
docker-compose.*.yml


##########  TYPESCRIPT / BUNDLERS (FUTURE-PROOF)  ##########
*.tsbuildinfo
.eslintcache
.stylelintcache
.svelte-kit/
.vite/
.vitepress/
.storybook/
.nuxt/
.next/
out/

########## SAFETY FINAL ######################################
# No raw credential files
*.key
*.pem
*.crt
*.p12
*.credential

###############################################################
# CORE READY • SAFE • FAST BUILD • ZERO NOISE • ZERO LEAKAGE  #
###############################################################
